OCUPA_APP_NAME=OCUPA API
OCUPA_ENVIRONMENT=development
OCUPA_DEBUG=false
DATABASE_URL=postgresql+asyncpg://ocupa:ocupa@localhost:5432/ocupa
TEST_DATABASE_URL=postgresql+asyncpg://ocupa_test:ocupa_test@localhost:5434/ocupa_test
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Values consumed by docker-compose.yml (development only).
POSTGRES_USER=ocupa
POSTGRES_PASSWORD=ocupa
POSTGRES_DB=ocupa
POSTGRES_TEST_USER=ocupa_test
POSTGRES_TEST_PASSWORD=ocupa_test
POSTGRES_TEST_DB=ocupa_test
